{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gnozis-archive-record-1.0.0",
  "title": "Gnozis Archive Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "created_at",
    "producer",
    "baseline",
    "status",
    "verification_status",
    "content",
    "content_sha256",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "record_type": {
      "type": "string",
      "enum": [
        "research",
        "reverse_analysis",
        "evidence",
        "snapshot",
        "summary",
        "decision",
        "audit"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "ref"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "observed",
        "reported",
        "active",
        "superseded",
        "rejected",
        "quarantined",
        "historical"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unknown",
        "unverified",
        "observed",
        "reproducible",
        "independently_verified",
        "failed"
      ]
    },
    "content": {},
    "content_sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string"
        },
        "transformation": {
          "type": "string"
        },
        "verification_scope": {
          "type": "string"
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "record_id"
        ],
        "properties": {
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}