{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gnozis Self-Learning Contract Database",
  "type": "object",
  "required": ["schema_version", "contract_scope", "contracts", "registry_entries", "findings", "authority", "provenance"],
  "properties": {
    "schema_version": {"type": "string"},
    "contract_scope": {"type": "string"},
    "source_revision": {"type": ["string", "null"]},
    "authority": {"const": "index_only"},
    "provenance": {"const": "self-learning-contract-database"},
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract_id", "title", "status", "source_path", "source_digest", "dependencies", "provenance"],
        "properties": {
          "contract_id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "string"},
          "source_path": {"type": "string"},
          "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "provenance": {"const": "self-learning-contract-database"}
        },
        "additionalProperties": false
      }
    },
    "registry_entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract_id", "status"],
        "properties": {"contract_id": {"type": "string"}, "status": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "findings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
